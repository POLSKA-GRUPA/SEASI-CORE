{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seasi/tenant-scope/v1",
  "title": "TenantScope",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id"],
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "case_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_ref": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
