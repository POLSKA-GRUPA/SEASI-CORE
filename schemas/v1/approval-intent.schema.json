{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seasi/approval-intent/v1",
  "title": "ApprovalIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant",
    "actor",
    "capability_id",
    "payload_digest",
    "created_at",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant": {
      "$ref": "seasi/tenant-scope/v1"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    }
  }
}
